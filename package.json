{
  "name": "guardagent",
  "version": "3.0.2",
  "description": "Telemetry & Monitoring Agent for Guard-Core TS and its thin adapters. Buffers security events and metrics, flushes them to the guard-core-app ingestion API with retry, backoff, payload-size split, and optional Redis crash recovery.",
  "keywords": [
    "guard-core",
    "guard-core-ts",
    "telemetry",
    "monitoring",
    "security",
    "middleware",
    "agent"
  ],
  "author": "Renzo Franceschini <rennf93@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rennf93/guard-agent-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rennf93/guard-agent-ts.git"
  },
  "bugs": {
    "url": "https://github.com/rennf93/guard-agent-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ioredis": "^5.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.25.0"
}
